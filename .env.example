# Copy this file to .env. Never commit the real .env file.
# Default provider: OpenAI (API billing is separate from ChatGPT subscriptions).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional Gemini provider (change LLM_PROVIDER and LLM_MODEL first):
# GOOGLE_API_KEY=replace_with_your_google_api_key

# Agent limits and retry settings
MAX_TOOL_CALLS=8
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1.5
